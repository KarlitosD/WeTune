# Puerto del servidor Nitro.
PORT=3000

# Cookie de sesión de YouTube (cadena completa, tal como la exporta el navegador).
# Nunca se versiona. Si estuvo en git, hay que rotarla.
YOUTUBE_COOKIE=

# Credenciales de YouTube para /api/song/data.
PO_TOKEN=
VISITOR_DATA=

# Orígenes permitidos por CORS. "*" por defecto.
ALLOW_ORIGINS=*
